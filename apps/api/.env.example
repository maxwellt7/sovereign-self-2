# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/sovereign_self
DIRECT_URL=postgresql://user:password@localhost:5432/sovereign_self

# Redis (optional, for BullMQ queues)
REDIS_URL=redis://localhost:6379

# Pinecone Vector DB
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_JOURNAL=journal-embeddings
PINECONE_INDEX_KNOWLEDGE=knowledge-embeddings
EMBEDDING_DIMENSION=1024

# OpenAI
OPENAI_API_KEY=

# Sentry (optional)
SENTRY_DSN=
